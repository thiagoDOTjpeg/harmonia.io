// ============================================
// HARMONIA.IO - SCHEMA DO BANCO DE DADOS
// Versão 2.0 - Modelo Normalizado com Tracks separadas
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 1. USUÁRIOS
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  name      String?

  // Login com email/senha
  passwordHash     String?  @db.Text
  emailVerifiedAt  DateTime?
  
  // OAuth Spotify
  spotifyId           String?  @unique
  spotifyAccessToken  String?  @db.Text
  spotifyRefreshToken String?  @db.Text
  spotifyTokenExpiry  DateTime?

  // OAuth Google/YouTube
  googleId            String?  @unique
  googleAccessToken   String?  @db.Text
  googleRefreshToken  String?  @db.Text
  googleTokenExpiry   DateTime?
  youtubeChannelId    String?
  
  // Relacionamentos
  playlists SyncedPlaylist[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("users")
}

// ============================================
// 2. PLAYLISTS SINCRONIZADAS
// ============================================

model SyncedPlaylist {
  id String @id @default(uuid())
  
  // Origem: YouTube
  youtubePlaylistId String
  youtubeUrl        String
  youtubeTitle      String?
  
  // Destino: Spotify
  spotifyPlaylistId String
  spotifyUrl        String
  spotifyTitle      String?
  
  // Controle de sincronização
  lastSyncedAt  DateTime?
  syncStatus    String    @default("pending") // pending, syncing, completed, failed
  
  // Dono da playlist
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Relacionamento N:N com Tracks através de PlaylistTrack
  playlistTracks PlaylistTrack[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, youtubePlaylistId])
  @@index([userId])
  @@map("synced_playlists")
}

// ============================================
// 3. TRACKS (MÚSICAS ÚNICAS - MASTER DATA)
// ============================================

model Track {
  id String @id @default(uuid())
  
  // YouTube (identificador único)
  youtubeVideoId String  @unique
  youtubeTitle   String
  youtubeChannel String?
  
  // Spotify (melhor match encontrado)
  spotifyTrackId String? @unique
  spotifyUri     String?
  spotifyArtist  String?
  spotifyAlbum   String?
  
  // Metadados de match
  matchScore    Float    @default(0)
  matchedAt     DateTime?
  matchSource   String?  // "manual", "auto", "ai"
  
  // Machine Learning (futuro)
  isOfficialVideo Boolean @default(false)
  isVisualizer    Boolean @default(false)
  isLive          Boolean @default(false)
  aiConfidence    Float?
  
  // Relacionamento N:N com Playlists
  playlistTracks PlaylistTrack[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([youtubeVideoId])
  @@index([spotifyTrackId])
  @@map("tracks")
}

// ============================================
// 4. PLAYLIST_TRACKS (JOIN TABLE N:N)
// ============================================

model PlaylistTrack {
  id String @id @default(uuid())
  
  // Referências
  playlistId String
  playlist   SyncedPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  
  trackId String
  track   Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  
  // Controle específico dessa música nessa playlist
  status   String   @default("pending") // pending, synced, failed
  addedAt  DateTime @default(now())
  position Int? // ordem na playlist (opcional)
  
  // Evita duplicatas
  @@unique([playlistId, trackId])
  @@index([playlistId])
  @@index([trackId])
  @@map("playlist_tracks")
}