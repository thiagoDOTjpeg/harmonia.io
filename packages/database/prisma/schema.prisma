generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(uuid())
  email               String?          @unique
  name                String?
  spotifyId           String?          @unique
  spotifyAccessToken  String?
  spotifyRefreshToken String?
  spotifyTokenExpiry  DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  emailVerifiedAt     DateTime?
  googleAccessToken   String?
  googleId            String?          @unique
  googleRefreshToken  String?
  googleTokenExpiry   DateTime?
  passwordHash        String?
  youtubeChannelId    String?
  playlists           SyncedPlaylist[]

  @@map("users")
}

model SyncedPlaylist {
  id                String          @id @default(uuid())
  youtubePlaylistId String
  youtubeUrl        String
  youtubeTitle      String?
  spotifyPlaylistId String
  spotifyUrl        String
  spotifyTitle      String?
  lastSyncedAt      DateTime?
  syncStatus        String          @default("pending")
  userId            String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  playlistTracks    PlaylistTrack[]
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, youtubePlaylistId])
  @@index([userId])
  @@map("synced_playlists")
}

model Track {
  id              String          @id @default(uuid())
  youtubeVideoId  String          @unique
  youtubeTitle    String
  youtubeChannel  String?
  spotifyTrackId  String?         @unique
  spotifyUri      String?
  spotifyArtist   String?
  spotifyAlbum    String?
  matchScore      Float           @default(0)
  matchedAt       DateTime?
  matchSource     String?
  isOfficialVideo Boolean         @default(false)
  isVisualizer    Boolean         @default(false)
  isLive          Boolean         @default(false)
  aiConfidence    Float?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  playlistTracks  PlaylistTrack[]

  @@index([youtubeVideoId])
  @@index([spotifyTrackId])
  @@map("tracks")
}

model PlaylistTrack {
  id         String         @id @default(uuid())
  playlistId String
  trackId    String
  status     String         @default("pending")
  addedAt    DateTime       @default(now())
  position   Int?
  playlist   SyncedPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track          @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId])
  @@index([trackId])
  @@map("playlist_tracks")
}

model UserDashboard {
  user_id            String    @id @map("user_id")
  email              String
  is_spotify_connected Boolean   @map("is_spotify_connected")
  is_youtube_connected Boolean   @map("is_youtube_connected")
  total_playlists    BigInt    @map("total_playlists")
  total_songs        BigInt    @map("total_songs")
  synced_songs       BigInt    @map("synced_songs")
  last_sync_at       DateTime? @map("last_sync_at")

  @@map("user_dashboard")
}
