generator client {
  provider = "prisma-client-js"
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String              @id @default(uuid())
  email               String?             @unique
  name                String?
  passwordHash        String?             @map("password_hash")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  emailVerifiedAt     DateTime?           @map("email_verified_at")
  playlists           SyncedPlaylist[]
  servicesConnections ServiceConnection[]

  @@map("users")
}

model SyncedPlaylist {
  id                String          @id @default(uuid())
  youtubePlaylistId String          @map("youtube_playlist_id")
  youtubeUrl        String          @map("youtube_url")
  youtubeTitle      String?         @map("youtube_title")
  spotifyPlaylistId String          @map("spotify_playlist_id")
  spotifyUrl        String          @map("spotify_url")
  spotifyTitle      String?         @map("spotify_title")
  lastSyncedAt      DateTime?       @map("last_synced_at")
  syncStatus        String          @default("pending") @map("sync_status")
  userId            String          @map("user_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  playlistTracks    PlaylistTrack[]
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, youtubePlaylistId])
  @@index([userId])
  @@map("synced_playlists")
}

model Track {
  id              String          @id @default(uuid())
  youtubeVideoId  String          @unique @map("youtube_video_id")
  youtubeTitle    String          @map("youtube_title")
  youtubeChannel  String?         @map("youtube_channel")
  spotifyTrackId  String?         @unique @map("spotify_track_id")
  spotifyUri      String?         @map("spotify_uri")
  spotifyArtist   String?         @map("spotify_artist")
  spotifyAlbum    String?         @map("spotify_album")
  matchScore      Float           @default(0) @map("match_score")
  matchedAt       DateTime?       @map("matched_at")
  matchSource     String?         @map("match_source")
  isOfficialVideo Boolean         @default(false) @map("is_official_video")
  isVisualizer    Boolean         @default(false) @map("is_visualizer")
  isLive          Boolean         @default(false) @map("is_live")
  aiConfidence    Float?          @map("ai_confidence")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  playlistTracks  PlaylistTrack[]

  @@index([youtubeVideoId])
  @@index([spotifyTrackId])
  @@map("tracks")
}

model PlaylistTrack {
  id         String         @id @default(uuid())
  playlistId String         @map("playlist_id")
  trackId    String         @map("track_id")
  status     String         @default("pending")
  addedAt    DateTime       @default(now()) @map("added_at")
  position   Int?
  playlist   SyncedPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track          @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId])
  @@index([trackId])
  @@map("playlist_tracks")
}

model UserSummary {
  userId                      String             @id @map("user_id")
  email                       String
  name                        String?
  userCreatedAt               DateTime           @map("user_created_at")
  isSpotifyConnected          Boolean            @map("is_spotify_connected")
  isYoutubeConnected          Boolean            @map("is_youtube_connected")
  totalPlaylists              BigInt             @map("total_playlists")
  syncedPlaylists             BigInt             @map("synced_playlists")
  totalSongs                  BigInt             @map("total_songs")
  syncedSongs                 BigInt             @map("synced_songs")
  syncedSongsLast7Days        BigInt             @map("synced_songs_last_7_days")
  lastSyncAt                  DateTime?          @map("last_sync_at")
  recentSyncs                 Json               @map("recent_syncs")

  @@map("user_summary")
}

model UserPlaylists {
  id                String    @id
  userId            String    @map("user_id")
  youtubePlaylistId String    @map("youtube_playlist_id")
  youtubeTitle      String?   @map("youtube_title")
  spotifyPlaylistId String    @map("spotify_playlist_id")
  spotifyTitle      String?   @map("spotify_title")
  syncStatus        String    @map("sync_status")
  lastSyncedAt      DateTime? @map("last_synced_at")
  createdAt         DateTime  @map("created_at")
  updatedAt         DateTime  @map("updated_at")
  songs             BigInt

  @@map("user_playlists")
}

enum ServiceProvider {
  GOOGLE
  SPOTIFY
}

model ServiceConnection {
  id                 String          @id @default(uuid())
  userId             String          @map("user_id")
  provider           ServiceProvider
  providerAccountId  String?         @unique @map("provider_account_id")
  email              String?
  accessToken        String          @map("access_token") @db.Text
  refreshToken       String?         @map("refresh_token") @db.Text
  accessTokenIv      String          @map("access_token_iv") @db.Text
  refreshTokenIv     String?         @map("refresh_token_iv") @db.Text
  expiresAt          DateTime?       @map("expires_at")
  scopes             String          @db.Text
  metadata           Json?
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("services_connections")
}