{
  "name": "@harmonia/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/main/index.ts",
    "worker": "dotenv -e ../../.env -- tsx watch src/main/worker.ts",
    "build": "dotenv -e ../../.env -- prisma generate --schema=../../packages/database/prisma/schema.prisma && tsc && tsc-alias",
    "start": "node dist/main/index.js",
    "db:generate": "dotenv -e ../../.env -- prisma generate --schema=../../packages/database/prisma/schema.prisma",
    "db:push": "dotenv -e ../../.env -- prisma db push --schema=../../packages/database/prisma/schema.prisma",
    "db:pull": "dotenv -e ../../.env -- prisma db pull --schema=../../packages/database/prisma/schema.prisma",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema=../../packages/database/prisma/schema.prisma",
    "db:studio": "dotenv -e ../../.env -- prisma studio --schema=../../packages/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@bull-board/api": "^5.10.0",
    "@bull-board/express": "^5.10.0",
    "@harmonia/database": "*",
    "@harmonia/shared": "*",
    "@prisma/client": "^6.18.0",
    "@types/nodemailer": "7.0.3",
    "bcrypt": "^5.1.1",
    "bcryptjs": "3.0.3",
    "bull": "^4.12.0",
    "bullmq": "5.63.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "7.0.10",
    "redis": "5.9.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@harmonia/config-typescript": "*",
    "@types/bcrypt": "^5.0.2",
    "@types/bull": "^4.10.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "prisma": "^6.18.0",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
