{
  "name": "harmonia.io",
  "version": "1.0.0",
  "description": "Sincronize playlists do YouTube com Spotify",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --watch src/main/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
